# ORCA Ocean Reasoning & Collaborative Agents Configuration
# Copy this file to .env and configure your production credentials

DEMO_MODE=true
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Maps API (Optional - for Street View Coverage)
GOOGLE_MAPS_API_KEY=

# Supabase Authentication & History Storage (Optional - falls back to local data store)
SUPABASE_URL=
SUPABASE_KEY=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000

